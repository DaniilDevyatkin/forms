{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true
    },
    {
      "name": "UI (Vite :5173)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Форма: всё",
      "configurations": ["API (FastAPI :8000)", "UI (Vite :5173)"]
    }
  ]
}
