# домен сайта (A-запись должна указывать на IP VPS)
SITE_DOMAIN=skoiptforma.ru
# порт на хосте, на который ваш прокси (nginx/другой) проксирует домен
SITE_PORT=8080

# админка
FORMA_ADMIN_USER=admin
FORMA_ADMIN_PASSWORD=admin123
# секрет подписи cookie-сессии — ОБЯЗАТЕЛЬНО заменить:
#   openssl rand -hex 32
FORMA_SECRET=change-me-please-use-a-long-random-hex-string

# путь к SQLite внутри контейнера (том /data)
FORMA_DB=/data/forma.db
