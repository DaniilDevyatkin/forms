  "narrative": {
    "northStar": "The Daylight Studio",
    "overview": "Светлая рабочая поверхность студии утром: тёплая бумага, графитовый текст, тонкие линии вместо рамок и один раскалённый уголь — единственная кнопка, которую нельзя пропустить.",
    "keyCharacteristics": [
      "Светлая тёплая база, белые панели, графитовый текст",
      "Один раскалённый акцент только на главном действии",
      "Ритм через интервалы и линии",
      "Моноширинный как маркер данных",
      "Движение только как отклик на состояние"
    ],
    "rules": [
      {
        "name": "The One Ember Rule",
